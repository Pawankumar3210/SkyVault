# Sky Vault environment
# Copy to .env.local for the Vite client and .env for the API process.
# Never commit real credentials.

NODE_ENV=development

# demo: browser IndexedDB, no Google Cloud required
# cloud: Firestore + Cloud Storage through the API
VITE_APP_MODE=demo
APP_MODE=demo

GCP_PROJECT_ID=
GCS_BUCKET_NAME=
GCP_REGION=us-central1

# Full service-account JSON on one line. Server only.
# Do not use a VITE_ prefix.
GOOGLE_APPLICATION_CREDENTIALS_JSON=

MAX_FILE_SIZE_MB=10
WORKSPACE_STORAGE_SOFT_LIMIT_MB=500
UPLOAD_WARNING_PERCENTAGE=70
UPLOAD_URL_EXPIRY_SECONDS=300
DOWNLOAD_URL_EXPIRY_SECONDS=900
MAX_RETAINED_VERSIONS=5

# Abandoned pending uploads are eligible for cleanup after this many seconds.
PENDING_UPLOAD_TTL_SECONDS=3600
# Pre-action workspace backups expire after this many days.
BACKUP_RETENTION_DAYS=7

# Comma-separated origins. Leave empty to allow same-origin only.
CORS_ALLOWED_ORIGIN=http://localhost:5173

PORT=8787
